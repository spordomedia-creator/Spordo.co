-        <div class="ext-note" style="margin-bottom:20px">This field is managed by <strong>${esc(f.operator)}</strong>, which operates its own independent permit system outside NYC Parks.</div>
-        <a class="ext-book-btn" href="${esc(f.bookingUrl)}" target="_blank" rel="noopener">Book at ${esc(f.orgShort)} →</a>
-        <div id="ext-permit-info" style="margin-top:20px"></div>
+        <div class="ext-note">This field is managed by <strong>${esc(f.operator)}</strong>, which operates its own independent permit system outside NYC Parks.</div>
+        <a class="ext-book-btn" href="${esc(f.bookingUrl)}" target="_blank" rel="noopener" style="margin-top:16px">Book at ${esc(f.orgShort)} →</a>
       </div>`;
-    loadPermitInfoCard(f, document.getElementById('ext-permit-info'));
+
+    if (!f._permitsLoaded) {
+      el.innerHTML = banner + `<div class="schd-week-none" style="padding:40px 0">Loading schedule…</div>`;
+      // Guard against a second concurrent fetch if the user toggles
+      // WEEK/MONTH again before the first one finishes.
+      if (!f._permitsLoading) {
+        f._permitsLoading = true;
+        loadExternalPermits(f).then(() => {
+          f._permitsLoading = false;
+          // Only re-render if the user hasn't navigated to a different
