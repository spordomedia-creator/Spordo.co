From b26e7139603b0e39d1f6142f453bd719dd09051e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 9 Jul 2026 10:56:00 +0000
Subject: [PATCH] Fix HRPT table parser: skip full-width banner row before the
 real header
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The live page renders a <thead> with two <th>-only rows: a full-width
colspan banner (the field-name heading image) followed by the actual
"Time + date" header row. parseTableToGrid assumed the first <tr> was
always the header, so it picked the 1-cell banner, yielded zero date
columns, and every field's real header row got misparsed as a body row
instead — which is why the deployed sync wrote 0 rows on every cron
tick despite the page fetch succeeding.
---
 src/hrpt/tableGrid.js      | 17 ++++++++++++++++-
 src/hrpt/tableGrid.test.js | 24 ++++++++++++++++++++++++
 2 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/src/hrpt/tableGrid.js b/src/hrpt/tableGrid.js
index 488a9df..d683c93 100644
--- a/src/hrpt/tableGrid.js
+++ b/src/hrpt/tableGrid.js
@@ -62,8 +62,23 @@ function parseTableToGrid(tableHtml) {
   }
 
   const rowCells = rows.map((row) => extractCells(row.innerHTML));
+  // A row is "header-only" if every cell came from a <th> (no <td> at all).
+  // Some live pages render a full-width banner row (e.g. a single
+  // <th colspan="N"> wrapping a heading image) ahead of the actual
+  // "corner + date cells" header row — both are <th>-only, so picking just
+  // "the first row" would grab the banner instead. Walk the leading run of
+  // <th>-only rows and use the last one with more than one cell as the real
+  // header; a banner row spanning the full width via colspan will only ever
+  // have a single cell. Pages with just one plain header row (the common
+  // case, and what the test fixtures use) still resolve to that same row.
+  const rowIsHeaderOnly = rows.map((row) => extractElements(row.innerHTML, "td").length === 0);
+  let headerIdx = 0;
+  for (let i = 0; i < rowIsHeaderOnly.length && rowIsHeaderOnly[i]; i++) {
+    if (rowCells[i].length > 1) headerIdx = i;
+  }
 
-  const [headerRow, ...bodyRows] = rowCells;
+  const headerRow = rowCells[headerIdx];
+  const bodyRows = rowCells.slice(headerIdx + 1);
   // The header row's first cell is the sticky "corner" (blank or a label
   // like "Time"); the remaining cells are the day-column headers.
   const columnHeaders = headerRow.slice(1).map((c) => c.text);
diff --git a/src/hrpt/tableGrid.test.js b/src/hrpt/tableGrid.test.js
index 413befc..fa92b2a 100644
--- a/src/hrpt/tableGrid.test.js
+++ b/src/hrpt/tableGrid.test.js
@@ -60,6 +60,30 @@ test("repeated-class pattern expands to the SAME dense grid as rowspan", () => {
   assert.deepEqual(repeatedResult.columnHeaders, rowspanResult.columnHeaders);
 });
 
+const BANNER_PLUS_HEADER_TABLE = `
+  <table>
+    <thead>
+      <tr><th colspan="3"><img src="heading.png" alt="Pier 25 Turf Field" /></th></tr>
+      <tr><th>Time</th><th>Sun<br /> 7/5</th><th>Mon<br /> 7/6</th></tr>
+    </thead>
+    <tbody>
+      <tr><td>6:00 AM</td><td></td><td></td></tr>
+      <tr><td>7:00 AM</td><td class="permitted">League A</td><td></td></tr>
+    </tbody>
+  </table>
+`;
+
+test("a full-width <th colspan> banner row ahead of the real <th> header row is skipped, not mistaken for the header", () => {
+  const { columnHeaders, rowLabels, grid, anomalies } = parseTableToGrid(BANNER_PLUS_HEADER_TABLE);
+  assert.deepEqual(columnHeaders, ["Sun 7/5", "Mon 7/6"]);
+  assert.deepEqual(rowLabels, ["6:00 AM", "7:00 AM"]);
+  assert.deepEqual(anomalies, []);
+  assert.deepEqual(statusGrid(grid), [
+    ["available", "available"],
+    ["booked", "available"],
+  ]);
+});
+
 test("logs an anomaly (not a throw) when a row has fewer cells than expected", () => {
   const html = `
     <table>
