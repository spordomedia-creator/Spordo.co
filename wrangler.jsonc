{
  // https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spordo",
  "main": "src/index.js",
  "compatibility_date": "2026-06-24",
  "observability": {
    "enabled": true
  },
  // Non-secret config. SUPABASE_URL is the same project URL already public
  // in public/TrueSpordo.html's SUPABASE_URL constant -- not sensitive, so
  // it's a plain var here rather than a Wrangler secret. The Socrata sync
  // (src/socrata/) and its read API (src/socrataPermitsApi.js) also need
  // two SECRETS that are NOT set here (set via `wrangler secret put` /
  // .dev.vars — see .dev.vars.example):
  //   SUPABASE_SERVICE_ROLE_KEY — required; write+read access to
  //     field_permit_cache/field_sync_meta bypasses RLS. Never the anon key.
  //   SOCRATA_APP_TOKEN — recommended; raises Socrata's per-IP rate limit.
  //     The sync still runs without it (logs a warning) but shares the
  //     low anonymous-request limit.
  "vars": {
    "SUPABASE_URL": "https://avwvtjsabmhqqeosqubw.supabase.co"
  },
  // Static assets (the HTML app) are served from ./public.
  // The ASSETS binding lets src/index.js fetch them.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Default ("auto-trailing-slash") redirects any *.html request to a
    // clean URL (e.g. /TrueSpordo.html -> 307 -> /TrueSpordo). That
    // silently ate the path on every client-side route (src/index.js's
    // SPA fallback rewrites to /TrueSpordo.html, which then got
    // redirected away from e.g. /soccer to /TrueSpordo, wiping out the
    // route before the client router ever saw it) -- "none" serves the
    // file directly with no redirect.
    "html_handling": "none"
  },
  // Scheduled sync jobs. Every 3 hours is a "good citizen" cadence for
  // hudsonriverpark.org (it's never cached upstream per its response
  // headers, but there's no reason to hammer it more often than field
  // availability actually changes) — see src/index.js `scheduled()` and
  // src/hrpt/sync.js. Adjust here if the cadence needs to change; it's the
  // only place the schedule is defined.
  "triggers": {
    "crons": ["0 */3 * * *"]
  },
  // D1 binding for the HRPT permit-sync pipeline (src/hrpt/d1Client.js,
  // src/hrpt/sync.js). D1 is reached at runtime via this binding
  // (env.DB.prepare(...).bind(...).run()/.batch()) — there's no URL or API
  // secret to configure here (unlike the Supabase REST client this
  // replaced); access is controlled entirely by this binding existing in
  // the Worker's deployment.
  //
  // `database_id` below is the real production database — provisioned,
  // migrated, and confirmed live (checked directly via the Cloudflare D1
  // API during a 2026-08-26 launch-readiness pass: field_permit_cache and
  // field_sync_meta both exist with fresh rows from that day's sync). Not
  // a placeholder; the note that used to be here describing manual
  // provisioning steps was stale and has been removed.
  //
  // Scoped only to the HRPT sync pipeline right now — this does NOT touch
  // the Supabase project the frontend (public/TrueSpordo.html) still uses
  // for auth and the DPR/NYC-Parks permit reads; that migration is
  // deliberately separate and hasn't happened here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spordo-hrpt",
      "database_id": "af3f5a92-9c55-4195-915c-22f0a0746d34",
      "migrations_dir": "migrations"
    }
  ]
}
