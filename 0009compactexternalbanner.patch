From 2c6e07e7345a466e0c77e02b75ccf5a85ae12e5d Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 10 Jul 2026 21:58:33 +0000
Subject: [PATCH] Move the "managed externally" note below the schedule, make
 it compact
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The disclaimer + booking-link card was a large centered box sitting
between the WEEK/MONTH toggle and the grid, pushing the actual
schedule below the fold and forcing a scroll to see it on every HRPT
field page.

Replaces the ~200px vertical card with a slim horizontal strip
(.schd-ext-footer) rendered AFTER the grid instead of before it —
renderSchdWeek/renderSchdMonth now take an optional suffixHtml
alongside the existing prefixHtml, so the schedule is the first thing
visible and the disclaimer becomes supplementary context underneath
it, same badge/link content, just repositioned and restyled.
---
 public/TrueSpordo.html | 56 +++++++++++++++++++++++++-----------------
 1 file changed, 33 insertions(+), 23 deletions(-)

diff --git a/public/TrueSpordo.html b/public/TrueSpordo.html
index 596ebd3..07a109a 100644
--- a/public/TrueSpordo.html
+++ b/public/TrueSpordo.html
@@ -1260,14 +1260,23 @@ body::after {
 .permit-type-badge.event  { background:rgba(168,85,247,0.12);  color:#a855f7; }
 .permit-type-badge.default{ background:rgba(98,180,207,0.12);  color:var(--c-accent); }
 
-.schd-ext-card {
-  max-width: 480px;
+/* Compact "managed externally" note — sits BELOW the schedule grid (not
+   above it) so the schedule itself is the first thing visible, and is
+   sized as a slim horizontal strip rather than a large centered card. */
+.schd-ext-footer {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 10px 16px;
+  margin-top: 24px;
+  padding: 12px 16px;
   background: var(--c-b200);
-  border: 1px solid rgba(245,158,11,0.2);
-  border-radius: 18px;
-  padding: 28px 32px 32px;
-  margin: 0 auto;
+  border: 1px solid rgba(245,158,11,0.15);
+  border-radius: 12px;
 }
+.schd-ext-footer .source-badge { flex-shrink: 0; }
+.schd-ext-footer .ext-note { flex: 1 1 240px; margin-top: 0; }
+.schd-ext-footer .ext-book-btn { flex-shrink: 0; margin-top: 0; padding: 7px 14px; }
 
 @media (max-width: 768px) {
   .schd-header { padding: 20px 20px 0; }
@@ -5021,20 +5030,21 @@ function renderSchdBody() {
   if (!f || !el) return;
 
   if (f.external) {
-    // Same "managed externally" disclaimer + booking link as before; the
-    // schedule itself below it now renders through the exact same
-    // renderSchdWeek/renderSchdMonth grid every other field uses, instead
-    // of a separately-styled card, once real data has been fetched once
-    // per field (see loadExternalPermits).
-    const banner = `
-      <div class="schd-ext-card" style="margin-bottom:20px">
-        <div style="margin-bottom:12px"><span class="source-badge">${esc(f.orgShort)}</span></div>
-        <div class="ext-note">This field is managed by <strong>${esc(f.operator)}</strong>, which operates its own independent permit system outside NYC Parks.</div>
-        <a class="ext-book-btn" href="${esc(f.bookingUrl)}" target="_blank" rel="noopener" style="margin-top:16px">Book at ${esc(f.orgShort)} →</a>
+    // Same "managed externally" disclaimer + booking link as before, now a
+    // slim horizontal strip that sits BELOW the schedule (see .schd-ext-footer)
+    // instead of a large card blocking it — the schedule itself renders
+    // through the exact same renderSchdWeek/renderSchdMonth grid every
+    // other field uses, once real data has been fetched once per field
+    // (see loadExternalPermits), and is the first thing visible.
+    const footer = `
+      <div class="schd-ext-footer">
+        <span class="source-badge">${esc(f.orgShort)}</span>
+        <div class="ext-note">Managed by <strong>${esc(f.operator)}</strong> — independent permit system outside NYC Parks.</div>
+        <a class="ext-book-btn" href="${esc(f.bookingUrl)}" target="_blank" rel="noopener">Book at ${esc(f.orgShort)} →</a>
       </div>`;
 
     if (!f._permitsLoaded) {
-      el.innerHTML = banner + `<div class="schd-week-none" style="padding:40px 0">Loading schedule…</div>`;
+      el.innerHTML = `<div class="schd-week-none" style="padding:40px 0">Loading schedule…</div>` + footer;
       // Guard against a second concurrent fetch if the user toggles
       // WEEK/MONTH again before the first one finishes.
       if (!f._permitsLoading) {
@@ -5050,9 +5060,9 @@ function renderSchdBody() {
     }
 
     if (S.panelView === 'month') {
-      renderSchdMonth(f, banner);
+      renderSchdMonth(f, '', footer);
     } else {
-      renderSchdWeek(f, banner);
+      renderSchdWeek(f, '', footer);
     }
     return;
   }
@@ -5114,7 +5124,7 @@ function renderSchdDay(f) {
     </div>`;
 }
 
-function renderSchdWeek(f, prefixHtml = '') {
+function renderSchdWeek(f, prefixHtml = '', suffixHtml = '') {
   const el = document.getElementById('schd-body');
   const base = new Date(); base.setHours(0,0,0,0);
   const DAY_NAMES = ['SUN','MON','TUE','WED','THU','FRI','SAT'];
@@ -5143,10 +5153,10 @@ function renderSchdWeek(f, prefixHtml = '') {
     </div>`;
   }).join('');
 
-  el.innerHTML = prefixHtml + `<div class="schd-week-grid">${cols}</div>`;
+  el.innerHTML = prefixHtml + `<div class="schd-week-grid">${cols}</div>` + suffixHtml;
 }
 
-function renderSchdMonth(f, prefixHtml = '') {
+function renderSchdMonth(f, prefixHtml = '', suffixHtml = '') {
   const el = document.getElementById('schd-body');
   if (!el) return;
   if (!S.monthViewDate) S.monthViewDate = new Date();
@@ -5192,7 +5202,7 @@ function renderSchdMonth(f, prefixHtml = '') {
       <div class="schd-month-title">${MON_NAME[month].toUpperCase()} ${year}</div>
       <button class="schd-month-btn" onclick="schdMonthNav(1)">NEXT →</button>
     </div>
-    <div class="schd-month-grid">${headers}${cells}</div>`;
+    <div class="schd-month-grid">${headers}${cells}</div>` + suffixHtml;
 }
 
 function schdMonthNav(dir) {
-- 
